# ─── Upstash Redis (free tier) ─────────────────────
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379

# ─── MongoDB Atlas (free M0 tier) ──────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/nox?retryWrites=true

# ─── Telegram ──────────────────────────────────────
BOT_TOKEN=your_bot_token

# Webhook mode (set WEBHOOK_DOMAIN for production, leave empty for polling)
# WEBHOOK_DOMAIN=https://nox-bot.fly.dev
# WEBHOOK_SECRET=random_secret_string

# ─── Helius (free tier — 100K credits/month) ───────
HELIUS_API_KEY=your_helius_api_key
HELIUS_WEBHOOK_SECRET=your_webhook_secret

# ─── Solana ────────────────────────────────────────
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ─── API ───────────────────────────────────────────
PORT=3099
API_SECRET=

# ─── Logging ───────────────────────────────────────
LOG_LEVEL=info
